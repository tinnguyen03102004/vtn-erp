{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@vtn/shared": ["./packages/shared/src"],
      "@vtn/shared/*": ["./packages/shared/src/*"],
      "@vtn/errors": ["./packages/errors/src"],
      "@vtn/schemas": ["./packages/schemas/src"],
      "@vtn/database": ["./packages/database/src"],
      "@vtn/database/*": ["./packages/database/src/*"],
      "@vtn/auth": ["./packages/auth/src"],
      "@vtn/auth/*": ["./packages/auth/src/*"],
      "@vtn/audit": ["./packages/audit/src"],
      "@vtn/vietnam": ["./packages/vietnam/src"],
      "@vtn/vietnam/*": ["./packages/vietnam/src/*"],
      "@vtn/logger": ["./packages/logger/src"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
